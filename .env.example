# انسخ هذا الملف إلى .env واملأ القيم الفعلية. .env نفسه مُتجاهَل من Git عمداً
# (لا يُرفع أبداً)؛ هذا الملف فقط (.env.example) هو ما يُشارَك مع الفريق.

# ─── الأمان الأساسي ───────────────────────────────────────────────
SECRET_KEY=django-insecure-change-me-in-production
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── البريد الإلكتروني (تحقق الحساب، استعادة كلمة المرور) ─────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ASPU Insight <noreply@aspu-insight.dz>
FRONTEND_URL=http://localhost:3000

# ─── Celery (معالجة غير متزامنة) ──────────────────────────────────
# الافتراضي: ناقل ملفات محلي (لا يحتاج Redis). للانتقال إلى Redis عند
# توفره: CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_BROKER_URL=filesystem://
CELERY_RESULT_BACKEND=django-db
CELERY_TASK_ALWAYS_EAGER=False

# ─── Redis (طبقة قنوات WebSocket + Cache عدّاد الإشعارات غير المقروءة) ──
# فارغ افتراضياً = في-الذاكرة (عملية واحدة فقط، كافٍ لتطوير محلي). للانتقال
# إلى Redis عند توفره: REDIS_URL=redis://localhost:6379/1
REDIS_URL=

# ─── إشعارات الجوال (Firebase Cloud Messaging) ─────────────────────
# فارغ افتراضياً = لا تطبيق جوال فعلي بعد (تصميم استشرافي)؛ صفوف تسليم push
# تتخلّى فوراً بلا محاولة اتصال. ضع مسار ملف اعتماد حساب خدمة Firebase (JSON) لتفعيله.
FIREBASE_CREDENTIALS_PATH=

# ─── Claim-to-Evidence Graph ───────────────────────────────────────
# اترك CLAIM_EVIDENCE_EMBEDDING_MODEL بلا قيمة (أو احذف السطر) لاستخدام النسخة المحلية
# الكاملة المرفقة بالمستودع (ai_service/ml_models/paraphrase-multilingual-MiniLM-L12-v2-base/)
# بدل تنزيلها من الإنترنت؛ ضع اسم/مسار نموذج آخر صراحة فقط إن أردت تغييره.
CLAIM_EVIDENCE_ZERO_SHOT_MODEL=MoritzLaurer/mDeBERTa-v3-base-mnli-xnli
CLAIM_EVIDENCE_SIMILARITY_THRESHOLD=0.2
CLAIM_EVIDENCE_TOP_CLAIMS_COUNT=10

# ─── فحص توافق IEEE ─────────────────────────────────────────────────
IEEE_CHECKER_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
IEEE_CHECKER_NER_MODEL=dslim/bert-base-NER
IEEE_CHECKER_MAX_LLM_REFS=30
IEEE_CHECKER_ENABLE_SECTION_CHECK=True
IEEE_CHECKER_ENABLE_SEMANTIC_MATCH=True
IEEE_CHECKER_SEMANTIC_MISMATCH_THRESHOLD=0.15

# ─── اقتراح الكلمات المفتاحية (KeyBERT) ────────────────────────────
# افتراضياً يستخدم النموذج المحلي المرفق بالمستودع (my-model/) — لا يحتاج مفتاحاً.
KEYWORD_EXTRACTOR_MODEL=

# ─── كشف الانتحال ───────────────────────────────────────────────────
# افتراضياً يستخدم النموذج المضبوط دقيقاً بعد تشغيل سكربت التدريب
# (ai_service/ml_training/train_plagiarism_embedder.py)؛ اتركه فارغاً
# لاستخدام القيمة الافتراضية، أو ضع اسم/مسار نموذج آخر صراحة.
PLAGIARISM_EMBEDDING_MODEL=
PLAGIARISM_INTERNAL_SIMILARITY_THRESHOLD=0.75
PLAGIARISM_EXTERNAL_SIMILARITY_THRESHOLD=0.6
PLAGIARISM_CHUNK_SENTENCES=4
PLAGIARISM_CHUNK_OVERLAP=1

# طبقات البحث الخارجي الاختيارية لكشف الانتحال — فارغة = معطَّلة تلقائياً بأمان.
# SEMANTIC_SCHOLAR_API_KEY: مجاني، سجّل على https://www.semanticscholar.org/product/api —
#   يمنح 1 طلب/ثانية مخصَّصاً بدل مشاركة المجمع العام المزدحم (يقلّل أخطاء 429 كثيراً).
# CORE_API_KEY: مجاني، سجّل على https://core.ac.uk
# VALUESERP_API_KEY: مدفوع، من https://www.valueserp.com
CORE_API_KEY=
VALUESERP_API_KEY=
