# انسخ هذا الملف إلى .env على السيرفر (وليس على جهازك المحلي) واملأ القيم.
# لا يُرفع هذا الملف نفسه بعد تعبئته لأي مكان عام (Git، إلخ) - يبقى فقط على السيرفر.

# ─── الأمان الأساسي ───────────────────────────────────────────────
# ولّد مفتاحاً جديداً عبر:
#   docker compose run --rm web python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=CHANGE_ME_GENERATE_NEW_KEY
CORS_ALLOWED_ORIGINS=https://YOUR_DOMAIN
DEBUG=False
ALLOWED_HOSTS=YOUR_DOMAIN,www.YOUR_DOMAIN

# ─── قاعدة البيانات (PostgreSQL عبر خدمة "db" في docker-compose.yml) ────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=aspu_insight
DB_USER=aspu_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_HOST=db
DB_PORT=5432

# ─── فرض HTTPS ──────────────────────────────────────────────────────
# فعّلهما فقط بعد نجاح الحصول على شهادة SSL فعلية (راجع DEPLOYMENT.md قسم SSL)
SECURE_PRODUCTION=False
BEHIND_HTTPS_PROXY=False

# ─── البريد الإلكتروني ──────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ASPU Insight <noreply@aspu-insight.dz>
FRONTEND_URL=https://YOUR_DOMAIN

# ─── Celery (عبر Redis - خدمة "redis" في docker-compose.yml) ───────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=django-db
CELERY_TASK_ALWAYS_EAGER=False

# ─── Redis (قنوات WebSocket + Cache) ────────────────────────────────
REDIS_URL=redis://redis:6379/1

# ─── إشعارات الجوال (Firebase) ─────────────────────────────────────
FIREBASE_CREDENTIALS_PATH=

# ─── Claim-to-Evidence Graph / فحص IEEE / كشف الانتحال ─────────────
# اتركها فارغة لاستخدام النماذج المحلية المرفوعة عبر scripts/upload_models.sh
CLAIM_EVIDENCE_ZERO_SHOT_MODEL=MoritzLaurer/mDeBERTa-v3-base-mnli-xnli
CLAIM_EVIDENCE_SIMILARITY_THRESHOLD=0.2
CLAIM_EVIDENCE_TOP_CLAIMS_COUNT=10

IEEE_CHECKER_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
IEEE_CHECKER_NER_MODEL=dslim/bert-base-NER
IEEE_CHECKER_MAX_LLM_REFS=30
IEEE_CHECKER_ENABLE_SECTION_CHECK=True
IEEE_CHECKER_ENABLE_SEMANTIC_MATCH=True
IEEE_CHECKER_SEMANTIC_MISMATCH_THRESHOLD=0.15

KEYWORD_EXTRACTOR_MODEL=

PLAGIARISM_EMBEDDING_MODEL=
PLAGIARISM_INTERNAL_SIMILARITY_THRESHOLD=0.75
PLAGIARISM_EXTERNAL_SIMILARITY_THRESHOLD=0.6
PLAGIARISM_CHUNK_SENTENCES=4
PLAGIARISM_CHUNK_OVERLAP=1

# طبقات البحث الخارجي الاختيارية - فارغة = معطَّلة تلقائياً بأمان
CORE_API_KEY=
VALUESERP_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
